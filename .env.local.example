OPENAI_API_KEY=sk-...

# Postgres. Any Neon connection string — the app talks to it over HTTP through
# @neondatabase/serverless, not a TCP socket, so a plain local Postgres will not
# answer on this. Create the tables with `npm run db:setup` once this is set.
DATABASE_URL=postgresql://user:password@host.neon.tech/dbname?sslmode=require
