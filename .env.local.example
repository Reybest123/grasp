OPENAI_API_KEY=sk-...

# Postgres. Any connection string works, including a local Postgres. For the
# Railway database, use the Postgres service's DATABASE_PUBLIC_URL here: the
# *.railway.internal address only resolves inside Railway. Create the tables
# with `npm run db:setup` once this is set.
DATABASE_URL=postgresql://user:password@host:port/dbname

# Resend, for the email that confirms a new account's address. Without a key,
# signup still works but no link is sent, so the account cannot be confirmed.
RESEND_API_KEY=re_...
# Optional. Leave unset to use Resend's test sender, which only delivers to the
# address your Resend account was made with. Real students need an address on a
# domain you have verified in Resend, e.g. Grasp <hello@yourdomain.com>.
EMAIL_FROM=
# Optional. The site's public address, used to build the link in the email,
# and Stripe Checkout's return address below.
# Unset, the address the request arrived on is used, which is right locally.
APP_URL=

# Stripe, for real billing (§6). A test-mode secret key (sk_test_...) is fine
# to start with; nothing here is charged until you use a real card.
STRIPE_SECRET_KEY=sk_test_...
# The signing secret Stripe gives you for the webhook endpoint you point at
# /api/webhooks/stripe (the Stripe CLI's `stripe listen` prints one for local
# testing; the dashboard gives you a separate one for a deployed endpoint).
STRIPE_WEBHOOK_SECRET=whsec_...
# The two weekly Prices billing subscribes accounts to. Create them with
# `npm run billing:setup`, which prints these two lines once they exist.
STRIPE_PRICE_PRO=price_...
STRIPE_PRICE_MAX=price_...
